{
  "name": "crid",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n vite,api -c blue,green \"vite\" \"npm run api\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "api": "tsx watch --tsconfig tsconfig.server.json server.ts",
    "api:start": "tsx --tsconfig tsconfig.server.json server.ts"
  },
